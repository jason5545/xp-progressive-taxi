  GROUP ASSUM TEMP
    SHOW_EQUAL 1.000000 laminar/B738/eicas/assum_temp_show
    LOCKED
    HIDE
    gen_rotary C ass temp
      POS 1256.000000 222.000000
      IMAGE EICAS/c_green
      DATAREF 
      LOCKED
      HIDE
      LIGHT_MODE GLASS_AUTO
      LIGHT_RHEOSTAT 4
      BUS_SRC 3
      KEY_FRAME 0.000000 0.000000 1.000000
      KEY_FRAME 1.000000 2.000000
      DIGITS 1
      ROTARY_TYPE NO_CLICK
      CLICK_RADIUS 10.000000
      CLICK_RADIUS_DY 0.000000
      OFFSET 0.000000
      STEP1 1.000000
      STEP2 1.000000
      CURSOR DEFAULT
      CLICK_DX 0
      CLICK_DY 0

    gen_rotary plus ass temp
      POS 1231.000000 222.000000
      IMAGE EICAS/plus_green
